# Copy to ".env" (same folder) and fill in. .env is git-ignored.
# `python savebrain.py setup` writes this for you -- editing by hand is optional.

# Free key from https://console.groq.com/keys
# Powers extraction, carousel OCR and video transcription.
GROQ_API_KEY=gsk_your_key_here

# OPTIONAL -- only if you set "fallback" in config.json to an endpoint that
# needs a key (OpenRouter, Cerebras, a hosted vLLM). Local servers like
# LM Studio and Ollama need no key at all.
# FALLBACK_API_KEY=
